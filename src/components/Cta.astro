---
import Icon from './Icon.astro';
import { cta, brand } from '../data/site.js';
---
<section class="cta" id="contact">
  <div class="container">
    <div class="cta__card">
      <svg class="cta__rings" viewBox="0 0 800 800" aria-hidden="true" focusable="false" data-cta-rings>
        <circle cx="400" cy="400" r="90" />
        <circle cx="400" cy="400" r="170" />
        <circle cx="400" cy="400" r="250" />
        <circle cx="400" cy="400" r="330" />
        <circle cx="400" cy="400" r="410" />
      </svg>
      <div class="cta__grid">
        <h2 class="cta__title" data-reveal>
          <span>{cta.title[0]}</span>
          <em>{cta.title[1]}</em>
        </h2>
        <div class="cta__side" data-reveal style="--r:1">
          <p>{cta.text}</p>
          <a class="btn btn--black" href={`mailto:${brand.email}`}><span>{cta.button}</span><Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </div>
</section>
