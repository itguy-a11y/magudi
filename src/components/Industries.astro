---
import Icon from './Icon.astro';
import { industriesIntro, industries } from '../data/site.js';
---
<section class="section industries" id="industries">
  <div class="container">
    <div class="sec-head">
      <h2 class="h2" data-reveal>{industriesIntro.title}</h2>
      <p class="lead" data-reveal style="--r:1">{industriesIntro.lead}</p>
    </div>

    <ul class="ind-row">
      {industries.map((i, n) => (
        <li class={`ind tone tone--${i.tone}`} data-reveal style={`--r:${n}`}>
          <a href="/#contact">
            <span class="ind__bar">
              <span class="ind__name">{i.short}</span>
              <span class="ind__arrow"><Icon name="arrow" size={18} /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
